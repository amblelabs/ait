#!/bin/bash

set -e

if [ $# -lt 2 ]; then
    echo "Usage: $0 <folder_path> <other_zip>"
    exit 1
fi

FOLDER_PATH="$1"
OTHER_ZIP="$2"

if [ ! -d "$FOLDER_PATH" ]; then
    echo "Error: Folder '$FOLDER_PATH' does not exist"
    exit 1
fi

if [ ! -f "$OTHER_ZIP" ]; then
    echo "Error: $OTHER_ZIP does not exist"
    exit 1
fi

# Collect all jars, excluding -sources.jar
mapfile -t -d '' JAR_FILES < <(
    find "$FOLDER_PATH" -maxdepth 1 -name "*.jar" -type f ! -name "*-sources.jar" -print0
)

if [ ${#JAR_FILES[@]} -eq 0 ]; then
    echo "Error: No .jar files found in '$FOLDER_PATH'"
    exit 1
fi

echo "Found ${#JAR_FILES[@]} jar file(s) to process"

WORK_DIR="/tmp/unzipped"

for JAR_FILE in "${JAR_FILES[@]}"; do
    echo "=========================================="
    echo "Processing: $JAR_FILE"

    rm -rf "$WORK_DIR"
    mkdir -p "$WORK_DIR"

    echo "Unzipping $JAR_FILE to $WORK_DIR"
    unzip -q "$JAR_FILE" -d "$WORK_DIR/"

    echo "Unzipping $OTHER_ZIP to $WORK_DIR"
    unzip -qo "$OTHER_ZIP" -d "$WORK_DIR/"

    rm -f "$JAR_FILE"

    echo "Creating new jar file: $JAR_FILE"
    jar --create --file="$JAR_FILE" -C "$WORK_DIR" .

    rm -rf "$WORK_DIR"

    echo "Done: $JAR_FILE"
done

echo "All jars processed successfully!"
