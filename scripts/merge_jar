#!/bin/bash

# Script to find all .jar files in a folder, unzip each, overlay another zip,
# and repackage as a new jar, preserving each original manifest.
set -e

if [ $# -lt 2 ]; then
    echo "Usage: $0 <folder_path> <other_zip>"
    exit 1
fi

FOLDER_PATH="$1"
OTHER_ZIP="$2"

if [ ! -d "$FOLDER_PATH" ]; then
    echo "Error: Folder '$FOLDER_PATH' does not exist"
    exit 1
fi

if [ ! -f "$OTHER_ZIP" ]; then
    echo "Error: $OTHER_ZIP does not exist"
    exit 1
fi

# Collect all jars (no exclusion)
mapfile -t -d '' JAR_FILES < <(
    find "$FOLDER_PATH" -maxdepth 1 -name "*.jar" -type f -print0
)

if [ ${#JAR_FILES[@]} -eq 0 ]; then
    echo "Error: No .jar files found in '$FOLDER_PATH'"
    exit 1
fi

echo "Found ${#JAR_FILES[@]} jar file(s) to process"

WORK_DIR="/tmp/unzipped"

for JAR_FILE in "${JAR_FILES[@]}"; do
    echo "=========================================="
    echo "Processing: $JAR_FILE"

    rm -rf "$WORK_DIR"
    mkdir -p "$WORK_DIR"

    echo "Unzipping $JAR_FILE to $WORK_DIR"
    unzip -q "$JAR_FILE" -d "$WORK_DIR/"

    # Save original manifest (if any) so the overlay cannot clobber it
    MANIFEST_BACKUP=""
    if [ -f "$WORK_DIR/META-INF/MANIFEST.MF" ]; then
        MANIFEST_BACKUP=$(mktemp)
        cp "$WORK_DIR/META-INF/MANIFEST.MF" "$MANIFEST_BACKUP"
        echo "Backed up original manifest"
    fi

    echo "Unzipping $OTHER_ZIP to $WORK_DIR"
    unzip -qo "$OTHER_ZIP" -d "$WORK_DIR/"

    # Restore original manifest
    if [ -n "$MANIFEST_BACKUP" ]; then
        mkdir -p "$WORK_DIR/META-INF"
        cp "$MANIFEST_BACKUP" "$WORK_DIR/META-INF/MANIFEST.MF"
        rm -f "$MANIFEST_BACKUP"
        echo "Restored original manifest"
    fi

    # Resolve absolute path before deleting the original
    JAR_FILE_ABS=$(realpath "$JAR_FILE")
    rm -f "$JAR_FILE_ABS"

    echo "Creating new jar file: $JAR_FILE_ABS"
    # Use zip (not jar) so the manifest is preserved byte-for-byte.
    ( cd "$WORK_DIR" && zip -qr "$JAR_FILE_ABS" . )

    rm -rf "$WORK_DIR"

    echo "Done: $JAR_FILE_ABS"
done

echo "All jars processed successfully!"
